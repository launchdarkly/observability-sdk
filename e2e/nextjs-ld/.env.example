# Copy to .env and fill in.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required — LaunchDarkly credentials
# ---------------------------------------------------------------------------
# Client-side ID for the environment that will receive browser session
# replay/errors/logs (looks like `mob-...` for a mobile-safe key, or the
# client-side id `abc123...` from the LD UI → Projects → Environments).
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_SIDE_ID=

# Server SDK key for the same environment (used by instrumentation.ts and the
# route wrappers). Get it from LD UI → Projects → Environments → SDK Key.
LAUNCHDARKLY_SDK_KEY=

# ---------------------------------------------------------------------------
# Which LaunchDarkly deployment to send data to
# ---------------------------------------------------------------------------
# 'production' (default) or 'staging'. Selects the hosts used by the
# same-origin proxy rewrites added by withLaunchDarklyConfig:
#   staging:  https://pub.observability.ld-stg.launchdarkly.com
#             https://otel.observability.ld-stg.launchdarkly.com:4318
#   prod:     https://pub.observability.app.launchdarkly.com
#             https://otel.observability.app.launchdarkly.com
LAUNCHDARKLY_ENV=staging

# Optional explicit overrides (highest precedence, applied to the proxy).
# LAUNCHDARKLY_BACKEND_URL=https://pub.observability.ld-stg.launchdarkly.com
# LAUNCHDARKLY_OTEL_ENDPOINT=https://otel.observability.ld-stg.launchdarkly.com:4318

# Optional server-side telemetry overrides (used by instrumentation.ts for the
# OTel exporter + sampling config of @launchdarkly/observability-node; the
# LAUNCHDARKLY_* names above are equivalent for the server side).
# LAUNCHDARKLY_OTLP_ENDPOINT=https://otel.observability.ld-stg.launchdarkly.com:4318

# Only needed when the proxy is disabled (configureLaunchDarklyProxy: false):
# the browser SDK then talks directly to these hosts.
# NEXT_PUBLIC_LAUNCHDARKLY_BACKEND_URL=https://pub.observability.ld-stg.launchdarkly.com
# NEXT_PUBLIC_LAUNCHDARKLY_OTLP_ENDPOINT=https://otel.observability.ld-stg.launchdarkly.com:4318

# ---------------------------------------------------------------------------
# Optional — labels & runtime
# ---------------------------------------------------------------------------
# The 'environment' attribute attached to all telemetry.
LD_OBSERVE_ENVIRONMENT=staging-e2e
# Service names shown in LaunchDarkly.
NEXT_PUBLIC_LD_SERVICE_NAME=nextjs-ld-frontend
LD_SERVICE_NAME=nextjs-ld-backend
# App version stamped into telemetry.
NEXT_PUBLIC_APP_VERSION=dev
# Origin the server uses to fetch its own API routes during SSR.
APP_ORIGIN=http://127.0.0.1:3006
PORT=3006
