# Required for live mode: set ONE of these. Leave both unset to run the offline
# demo, which drives the flags with the SDK's TestData source and needs no
# credentials.
#
# A mobile key sees every flag in the environment. A client-side ID sees only
# flags with "SDKs using Client-side ID" turned on.
LD_MOBILE_KEY=your-mobile-key
# LD_CLIENT_SIDE_ID=your-client-side-id

# Flags to watch, comma-separated
# Default: the four dashboard flags
# LD_FLAG_KEYS=dashboard,dashboard-progress-meters,dashboard-line-chart,dashboard-bar-chart

# The context flags are evaluated for
# LD_CONTEXT_KIND=user
# LD_CONTEXT_KEY=demo-user@example.com
LD_ENV=development

# Add the ld_application and ld_device contexts the SDK can generate
# LD_AUTO_ENV_ATTRIBUTES=true

# Reprint the watched flags on a timer. Off by default: changes print as they
# arrive, and 'l' prints a snapshot on demand.
# DEMO_TICKS=true

# Seconds between ticks, and between sample changes in offline mode
DEMO_INTERVAL_SECONDS=5

# Session replay demos only: log each batch of frames sent to LaunchDarkly.
# REPLAY_DEBUG=true

# Dashboard only: pre-fill the user in its setup dialog. The email is the
# context key.
# LD_USER_EMAIL=demo-user@example.com
# LD_USER_NAME=Demo User

# Every console setting above has a command-line equivalent that overrides it.
# Run with --help to see them.
